
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>


<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.asd.SearchController" style="-fx-background-color: lightgrey; -fx-font-size: 14px; -fx-font-family: 'Arial';">
   <children>
      <Label text="Search Item" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
      <TextField fx:id="searchIDField" maxWidth="150"/>
      <Button fx:id="primaryButton" text="Search Product" onAction="#searchProduct" style="-fx-background-color: green; -fx-text-fill: white;"/>

      <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, #888888, 5, 0, 0, 1);">
         <Label text="Results" style="-fx-font-weight: bold; -fx-font-size: 18px;" />
         
         <!-- Example Order Card -->
         <VBox style="-fx-background-color: #f7f7f7; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #dddddd; -fx-border-radius: 5; -fx-border-width: 1;">
            <HBox spacing="10">
                <ImageView fx:id="itemImage" fitWidth="100" fitHeight="100" visible="true">
                    <image>
                        <Image url="@com/asd/images/eggs.jpg" />
                    </image>
                </ImageView>
               <VBox>
                  <Label fx:id="productname"  style="-fx-font-weight: bold;" />
                  <Label fx:id="price" />
                  <Label fx:id="quantitiy"/>
                  <Label fx:id="priceper"/>
               </VBox>
            </HBox>
         </VBox>
      </VBox>
      <HBox alignment="CENTER_RIGHT">
         <Button fx:id="changePage" text="Order Track Page" onAction="#changePage" />
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
