<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.asd.CartController" spacing="10" alignment="CENTER" maxWidth="500">
    <Label text="MY CART" alignment="CENTER" />
    <TextField fx:id="searchField" promptText="Search items..." />
    <ListView fx:id="itemListView" prefHeight="400" prefWidth="300" />
    <HBox alignment="CENTER" spacing="15">
    <Label text="Total :"/>
    <Label fx:id="total" text="0.0"/>
    <Button text="Make Order" fx:id="cartButton" onAction="#makeOrder"/>
    </HBox>
    <Label text="Order has been made" fx:id="made" visible="false"/>
    <Button text="Track Orders" fx:id="trackOrderButton" onAction="#changePage" visible="false"/>
</VBox>
