<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.asd.HomePageController" spacing="20" alignment="CENTER"
      style="-fx-background-color: #dbefff; -fx-padding: 20; -fx-border-color: #c0d6e8; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10;">
    
    <HBox spacing="10" alignment="CENTER"
          style="-fx-background-color: #a8c7e6; -fx-padding: 10; -fx-border-color: #a0cce5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #a0cce5, 10, 0.3, 0, 0);">
        <Label text="Search:" style="-fx-font-size: 14; -fx-text-fill: #4a4a4a;" />
        <TextField fx:id="searchField" promptText="Search items..." prefWidth="400" maxWidth="400" minWidth="200"
                   style="-fx-font-size: 13; -fx-padding: 5; -fx-border-color: #a0cce5; -fx-border-radius: 5; -fx-background-radius: 5; -fx-background-color: #ffffff; -fx-text-fill: #4a4a4a;" />
 <Button text="View Cart" fx:id="cartButton" onAction="#changePage"
        style="-fx-background-color: #4caf50; -fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 5 10; -fx-background-radius: 5; -fx-effect: dropshadow(gaussian, #a0cce5, 5, 0.3, 0, 2);" />
    </HBox>

    <ScrollPane fx:id="scrollPane" fitToWidth="true" fitToHeight="true"
                style="-fx-background: #ffffff; -fx-border-color: #c0d6e8; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10;">
        <content>
            <GridPane fx:id="itemGrid" hgap="15" vgap="15" style="-fx-padding: 15;" />
        </content>
    </ScrollPane>
</VBox>
