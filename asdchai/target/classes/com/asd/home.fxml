<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.asd.HomePageController" spacing="20" alignment="CENTER"
      style="-fx-background-color: #0a1f44; -fx-padding: 20; -fx-border-color: #1a2d50; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10;">
    
    <HBox spacing="10" alignment="CENTER"
          style="-fx-background-color: #1a2d50; -fx-padding: 10; -fx-border-color: #263859; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, #0d1b33, 10, 0.3, 0, 0);">
        <Label text="Search:" style="-fx-font-size: 14; -fx-text-fill: #d4e1ff;" />
        <TextField fx:id="searchField" promptText="Search items..." prefWidth="400" maxWidth="400" minWidth="200"
                   style="-fx-font-size: 13; -fx-padding: 5; -fx-border-color: #3a4a6f; -fx-border-radius: 5; -fx-background-radius: 5; -fx-background-color: #0f2742; -fx-text-fill: #d4e1ff;" />
        <Button text="View Cart" fx:id="cartButton" onAction="#changePage"
                style="-fx-background-color: #3a4a6f; -fx-text-fill: #d4e1ff; -fx-font-size: 13; -fx-padding: 5 10; -fx-background-radius: 5; -fx-effect: dropshadow(gaussian, #2e3e5c, 5, 0.3, 0, 2);" />
    </HBox>

    <ScrollPane fx:id="scrollPane" fitToWidth="true" fitToHeight="true"
                style="-fx-background: #0a1f44; -fx-border-color: #1a2d50; -fx-border-width: 2; -fx-border-radius: 10; -fx-background-radius: 10;">
        <content>
            <GridPane fx:id="itemGrid" hgap="15" vgap="15" style="-fx-padding: 15;" />
        </content>
    </ScrollPane>
</VBox>
